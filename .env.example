# 端口
PORT=3000

# JWT 签名密钥（留空时自动生成到 server/data/jwt.secret，重启后登录态不丢）
JWT_SECRET=

# AI 问答：OpenAI 兼容接口。未配置密钥时自动降级为内置离线规则知识库
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 微信小程序一键登录（未配置时小程序提示改用账号密码）
WX_APPID=
WX_SECRET=

# MQTT 设备接入（npm run mqtt 启动适配层；指向 EMQX / Mosquitto / 本地 broker）
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_PREFIX=gushi
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BROKER_PORT=1883

# 一体部署：Express 同时托管 H5 产物
H5_DIST=demo

# Docker / Caddy：填域名即自动签发 HTTPS，留空用 :80
DOMAIN=
